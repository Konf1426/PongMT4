/* HUD Circle Pong — UI Toolkit (cohérent avec le menu titre) */

.hud-root {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

/* Cartes — cachées par défaut, le contrôleur affiche l'écran actif (évite la
   superposition des 5 panneaux en mode édition et tout flash au lancement). */
.card {
    display: none;
    position: absolute;
    background-color: rgba(13, 17, 23, 0.92);
    border-radius: 14px;
    border-width: 1px;
    border-color: rgba(88, 230, 200, 0.25);
    padding-top: 18px;
    padding-bottom: 18px;
    padding-left: 20px;
    padding-right: 20px;
}

.card--center {
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 420px;
    align-items: stretch;
}

.card--topleft {
    left: 16px;
    top: 16px;
    width: 320px;
}

.card-title {
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(88, 230, 200);
    -unity-text-align: middle-center;
    margin-bottom: 2px;
}

.card-title--small {
    font-size: 22px;
    -unity-text-align: upper-left;
    margin-bottom: 8px;
}

.card-subtitle {
    font-size: 16px;
    color: rgb(140, 160, 175);
    -unity-text-align: middle-center;
    margin-bottom: 16px;
}

/* Boutons */
.primary-button {
    height: 52px;
    margin-top: 8px;
    margin-bottom: 8px;
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(13, 17, 23);
    background-color: rgb(88, 230, 200);
    border-width: 0;
    border-radius: 10px;
    transition-property: background-color, scale;
    transition-duration: 0.12s;
}

.primary-button:hover {
    background-color: rgb(120, 245, 215);
    scale: 1.02 1.02;
}

.primary-button:active {
    scale: 0.98 0.98;
}

.secondary-button {
    height: 40px;
    margin-top: 6px;
    margin-bottom: 6px;
    font-size: 15px;
    color: rgb(200, 215, 225);
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 1px;
    border-color: rgb(60, 72, 84);
    border-radius: 8px;
}

.secondary-button:hover {
    background-color: rgba(255, 255, 255, 0.12);
}

/* Texte */
.info {
    font-size: 14px;
    color: rgb(200, 215, 225);
    margin-top: 2px;
    margin-bottom: 2px;
}

.info--accent {
    color: rgb(88, 230, 200);
    -unity-font-style: bold;
}

.hint {
    font-size: 12px;
    color: rgb(120, 135, 148);
    white-space: normal;
    margin-top: 10px;
}

/* Lobby local */
.row {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
    margin-bottom: 6px;
}

.row-label {
    font-size: 14px;
    color: rgb(200, 215, 225);
    width: 60px;
}

.count-field {
    width: 48px;
}

.mini-button {
    width: 34px;
    height: 26px;
    margin-left: 4px;
    font-size: 14px;
    background-color: rgba(255, 255, 255, 0.08);
    color: rgb(220, 228, 235);
    border-width: 1px;
    border-color: rgb(60, 72, 84);
    border-radius: 6px;
}

.mini-button:hover {
    background-color: rgba(255, 255, 255, 0.16);
}

.toggle {
    margin-top: 6px;
    margin-bottom: 6px;
    color: rgb(200, 215, 225);
}

/* Listes de devices réseau */
.device-list {
    margin-top: 4px;
}

.device-header {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(140, 160, 175);
    margin-top: 6px;
}

.device-item {
    font-size: 13px;
    color: rgb(200, 215, 225);
    margin-left: 8px;
}

/* Contrôles tactiles */
.mobile-bar {
    display: none;
    position: absolute;
    bottom: 24px;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
}

.mobile-btn {
    width: 120px;
    height: 72px;
    margin-left: 12px;
    margin-right: 12px;
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(13, 17, 23);
    background-color: rgba(88, 230, 200, 0.85);
    border-width: 0;
    border-radius: 12px;
}
